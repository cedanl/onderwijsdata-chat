# SOPS-encrypted secret template
# In production, this file is encrypted with age key
# Generate SOPS file with: sops --encrypt manifests/development/secret.yaml > manifests/development/secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: onderwijsdata-chat-secrets
type: Opaque
stringData:
  # Willma API key for LLM access — SDP only uses Willma, no direct provider keys.
  WILLMA_API_KEY: "..."

  # Signs auth tokens (core/auth.py) — generate with:
  # python -c 'import secrets; print(secrets.token_hex(32))'
  CHAT_SECRET: "..."

  # Password-login credentials, "user:password" pairs
  CHAT_USERS: "..."

# PostgreSQL connection string comes from the platform-provisioned
# onderwijsdata-chat-app secret (CloudNativePG), not from here.
