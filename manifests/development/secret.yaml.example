# Template for manifests/development/secret.yaml (SOPS-encrypted in git).
# Copy to secret_orig.yaml (gitignored), fill in the values, encrypt: see docs/deployment.md, "Secrets Configuration".
# The keys are exactly the ones manifests/development/values.yaml reads with secretKeyRef (tests/test_manifests.py).

apiVersion: v1
kind: Secret
metadata:
  name: onderwijsdata-chat-secrets
type: Opaque
stringData:
  # Signs auth tokens (core/auth.py) — generate with:
  # python -c 'import secrets; print(secrets.token_hex(32))'
  CHAT_SECRET: "..."

  # Password-login credentials, "user:password" pairs
  CHAT_USERS: "..."

  # Willma (SURF) API key for the Willma models
  WILLMA_API_KEY: "..."

  # Azure AI Foundry: the default model (MODEL) and the model picker run on it
  AZURE_AI_API_KEY: "..."
  AZURE_AI_API_BASE: "..."

# PostgreSQL connection string comes from the platform-provisioned
# onderwijsdata-chat-app secret (CloudNativePG), not from here.
