# SOPS-encrypted secret template
# In production, this file is encrypted with age key
# Generate SOPS file with: sops --encrypt manifests/development/secret.yaml > manifests/development/secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: onderwijsdata-chat-secrets
type: Opaque
stringData:
  # PostgreSQL connection string (from CloudNativePG cluster in tenant namespace)
  POSTGRES_URI: "postgresql://onderwijsdata-chat:<password>@onderwijsdata-chat-rw.services-onderwijsdata-chat.svc:5432/onderwijsdata_chat"

  # Anthropic API key for LLM
  ANTHROPIC_API_KEY: "sk-ant-..."

  # Random session secret for auth
  SESSION_SECRET: "$(python -c 'import secrets; print(secrets.token_hex(32))')"
