# Template for manifests/test/secret.yaml (SOPS-encrypted in git).
# Copy to secret_orig.yaml (gitignored), fill in the values, encrypt: see docs/deployment.md, "Secrets Configuration".
# The keys are exactly the ones manifests/test/values.yaml reads with secretKeyRef (tests/test_manifests.py).

apiVersion: v1
kind: Secret
metadata:
  name: onderwijsdata-chat-secrets
type: Opaque
stringData:
  # SRAM OIDC client (OIDC_PROVIDER in values.yaml)
  OIDC_CLIENT_ID: "..."
  OIDC_CLIENT_SECRET: "..."

  # Signs auth tokens (core/auth.py) — generate with:
  # python -c 'import secrets; print(secrets.token_hex(32))'
  CHAT_SECRET: "..."

  # Password-login credentials, "user:password" pairs; password login coexists with SRAM
  CHAT_USERS: "..."

  # Willma (SURF) API key for the Willma models
  WILLMA_API_KEY: "..."

  # Azure AI Foundry: the Foundry models in the model picker
  AZURE_AI_API_KEY: "..."
  AZURE_AI_API_BASE: "..."

  # Studiekeuzedatabase API key (optional in values.yaml)
  STUDIEKEUZEDATABASE_API_KEY: "..."

  # HMAC key for log hashes (core/logging_util.py, optional in values.yaml) — generate like CHAT_SECRET
  LOG_HASH_SECRET: "..."

  # API keys for /mcp (docs/mcp.md, optional in values.yaml), comma-separated, one per consumer — generate each with:
  # python -c 'import secrets; print(secrets.token_urlsafe(32))'
  MCP_API_KEYS: "..."

# PostgreSQL connection string comes from the platform-provisioned
# onderwijsdata-chat-app secret (CloudNativePG), not from here.
