# SOPS-encrypted secret template
# Fill in real values, then encrypt with:
#   sops --encrypt manifests/playground/secret.yaml.filled > manifests/playground/secret.yaml
# (matches manifests/test/secret.yaml — same age recipient, see .sops.yaml)

apiVersion: v1
kind: Secret
metadata:
  name: onderwijsdata-chat-secrets
type: Opaque
stringData:
  # Willma API key for LLM access — SDP only uses Willma, no direct provider keys.
  WILLMA_API_KEY: "..."

  # Signs auth tokens (core/auth.py) — generate with:
  # python -c 'import secrets; print(secrets.token_hex(32))'
  CHAT_SECRET: "..."

  # Password-login credentials, "user:password" pairs
  CHAT_USERS: "..."

# PostgreSQL connection string comes from the platform-provisioned
# onderwijsdata-chat-app secret (CloudNativePG), not from here.
# No OIDC_CLIENT_ID/OIDC_CLIENT_SECRET here — playground doesn't have
# SRAM OIDC wired up (see manifests/playground/values.yaml); password
# login via CHAT_USERS is the only auth path in this environment.
